                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginBottom="5dp"
                    android:layout_marginTop="5dp"
                    android:layout_span="2"
                    android:text="양증"
                    android:textAppearance="?android:attr/textAppearanceLarge" />

